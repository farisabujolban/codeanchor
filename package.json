{
    "name": "@farisabujolban/codeanchor",
    "version": "0.2.0",
    "description": "Deterministic tech-debt and workflow-drift CLI",
    "license": "MIT",
    "type": "module",
    "bin": {
        "codeanchor": "dist/cli.js"
    },
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "lint": "eslint . --max-warnings=0",
        "lint:fix": "eslint . --fix --max-warnings=0",
        "fmt": "prettier --write .",
        "fmt:check": "prettier --check .",
        "tc": "tsc --noEmit",
        "release": "release-it",
        "prepare": "husky",
        "prepublishOnly": "npm run build"
    },
    "files": [
        "dist"
    ],
    "keywords": [
        "git",
        "cli",
        "lint",
        "stale",
        "drift",
        "workflow"
    ],
    "engines": {
        "node": ">=22"
    },
    "dependencies": {
        "commander": "^12.1.0",
        "js-yaml": "^4.1.1"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.0.2",
        "@commitlint/config-conventional": "^21.0.2",
        "@farisabujolban/eslint-plugin-codeanchor": "^0.2.0",
        "@release-it/conventional-changelog": "^11.0.1",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^22.0.0",
        "@vitest/coverage-v8": "^1.6.1",
        "eslint": "^9.0.0",
        "husky": "^9.0.0",
        "lint-staged": "^15.0.0",
        "prettier": "^3.0.0",
        "release-it": "^20.2.0",
        "typescript": "^5.4.0",
        "typescript-eslint": "^8.0.0",
        "vitest": "^1.6.0"
    }
}
